#!/bin/sh
# =============================================================================
# edge-route —— 管理「域名前缀 → 本机端口」路由（edge-router / nginx）
#
#   edge-route add <前缀> <端口> [备注]    例： edge-route add cad 2228
#   edge-route rm  <前缀>
#   edge-route list                        # 列出路由 + 探测端口是否在听
#   edge-route reload                      # 重新生成配置并热加载
#   edge-route logs [行数]                 # 最近访问日志
#
# 数据文件：/etc/esc/edge/routes.tsv  （前缀<TAB>端口<TAB>备注）
# 生成文件：/etc/esc/edge/routes.conf  （nginx map，勿手改）
# =============================================================================
set -eu

DIR=/etc/esc/edge
DATA=$DIR/routes.tsv
CONF=$DIR/routes.conf
CONTAINER=edge-router
IMAGE=nginx:alpine

mkdir -p "$DIR"
[ -f "$DATA" ] || : > "$DATA"

die() { echo "错误：$*" >&2; exit 1; }

usage() {
  sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
}

# 从 routes.tsv 生成 nginx map
gen() {
  tmp=$(mktemp)
  {
    echo "# 由 edge-route 生成，勿手改（源数据：$DATA）"
    echo "map \$edge_prefix \$edge_backend {"
    echo '    default "";'
    while IFS="$(printf '\t')" read -r _gp _gport _gnote; do
      [ -z "${_gp:-}" ] && continue
      case "$_gp" in \#*) continue ;; esac
      printf '    "%s"    %s;   # %s\n' "$_gp" "$_gport" "${_gnote:-}"
    done < "$DATA"
    echo "}"
  } > "$tmp"
  mv "$tmp" "$CONF"
}

# 校验配置（在一次性容器里跑 nginx -t，避免依赖宿主机 nginx）
check() {
  docker run --rm --network host \
    -v "$DIR:/etc/nginx/edge:ro" \
    -v /etc/ssl/edge:/etc/ssl/edge:ro \
    "$IMAGE" nginx -t -c /etc/nginx/edge/nginx.conf 2>&1 | tail -2
}

reload_hard() {
  # 首次启动，或配置校验失败时重建容器。
  # 注意：挂**目录**而不是单文件 —— routes.conf 由 gen() 用 tmp+mv 原子替换，
  # 单文件 bind mount 会一直指向旧 inode，导致 add/rm 后容器读不到新配置。
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker run -d --name "$CONTAINER" --restart unless-stopped --network host \
    -v "$DIR:/etc/nginx/edge:ro" \
    -v /etc/ssl/edge:/etc/ssl/edge:ro \
    --label app=edge-router \
    "$IMAGE" nginx -g 'daemon off;' -c /etc/nginx/edge/nginx.conf >/dev/null
  echo "容器 $CONTAINER 已启动"
}

reload() {
  gen
  # 1) 先用一次性容器校验（nginx -t 不绑定端口，不会和运行中的实例抢 80/2229）
  if ! out=$(check 2>&1); then
    echo "配置校验失败，未加载（运行中的配置保持不变）：" >&2
    echo "$out" >&2
    return 1
  fi
  # 2) 已在跑就热加载；没跑或处在重启循环里就重建
  state=$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo missing)
  # -c 必须给：否则 nginx -s reload 会去读默认的 /etc/nginx/nginx.conf，
  # 找不到同样的 pid 文件就报错，进而误走重建分支（那一瞬间端口会短暂中断）
  if [ "$state" = "running" ] && docker exec "$CONTAINER" nginx -s reload -c /etc/nginx/edge/nginx.conf 2>/dev/null; then
    echo "已热加载（nginx -s reload）"
  else
    reload_hard
  fi
}

port_listen() {
  # 端口是否在宿主机上被监听
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"
  else
    return 1
  fi
}

probe() {
  # 真的发一个请求看看（只取状态码）
  curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:$1/" 2>/dev/null || echo "---"
}

case "${1:-}" in
  add)
    [ $# -ge 3 ] || { usage; exit 1; }
    pfx=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
    port=$3
    note=${4:-}
    case "$pfx" in
      ""|*[!a-z0-9_-]*) die "前缀只能用 [a-z0-9_-]：$pfx" ;;
    esac
    case "$port" in
      ""|*[!0-9]*) die "端口必须是数字：$port" ;;
    esac
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "端口越界：$port"
    # 同前缀 → 覆盖；同端口 → 允许（一个服务挂多个域名是常见需求）
    awk -F'\t' -v p="$pfx" '$1!=p' "$DATA" > "$DATA.new"
    printf '%s\t%s\t%s\n' "$pfx" "$port" "$note" >> "$DATA.new"
    mv "$DATA.new" "$DATA"
    reload
    echo "✓ $pfx.* -> 127.0.0.1:$port ${note:+($note)}"
    peers=$(awk -F'\t' -v p="$pfx" -v pt="$port" '$1!=p && $2==pt {printf "%s ", $1}' "$DATA")
    [ -n "$peers" ] && echo "  提示：端口 $port 还被这些前缀共用：$peers"
    ;;

  rm|delete|del)
    [ $# -ge 2 ] || { usage; exit 1; }
    pfx=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
    grep -q "^$pfx$(printf '\t')" "$DATA" 2>/dev/null || die "没有这个前缀：$pfx"
    grep -v "^$pfx$(printf '\t')" "$DATA" > "$DATA.new" || true
    mv "$DATA.new" "$DATA"
    reload
    echo "✓ 已删除 $pfx"
    ;;

  list|ls)
    printf '%-16s %-8s %-10s %-8s %s\n' 前缀 端口 监听 探测 备注
    while IFS="$(printf '\t')" read -r _lp _lport _lnote; do
      [ -z "${_lp:-}" ] && continue
      case "$_lp" in \#*) continue ;; esac
      if port_listen "$_lport"; then _lsn=是; else _lsn=否; fi
      printf '%-16s %-8s %-10s %-8s %s\n' "$_lp" "$_lport" "$_lsn" "$(probe "$_lport")" "${_lnote:-}"
    done < "$DATA"
    echo
    echo "容器：$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null || echo 未创建)"
    ;;

  reload) reload ;;

  logs)
    docker logs --tail "${2:-40}" "$CONTAINER" 2>&1
    ;;

  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
