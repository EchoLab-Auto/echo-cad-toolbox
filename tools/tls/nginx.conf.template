# ---------------------------------------------------------------------------
# 同一个端口同时服务 http:// 和 https://
#
# 为什么不用两个端口：云主机的安全组是白名单，新开端口要去控制台放行；而
# `https://` 只是 URL scheme，浏览器不关心端口号，任何端口都能是安全上下文。
# 所以复用已经在用的那个端口，一分钱不花、一条安全组规则都不用加。
#
# 怎么做：stream 层用 ssl_preread 看首字节 ——
#   TLS ClientHello（0x16 0x03）→ 交给本机 https server 终止 TLS
#   其余（GET/POST…）          → 原样透传给后端，老链接继续能用
# 而 https 走的是真正的 http 层，才能补上 X-Forwarded-Proto，让后端知道
# 自己是被 https 访问的（否则生成的绝对 URL 会退回 http）。
#
# 占位符由 tools/tls.sh 用 sed 替换：__TLS_PORT__ __BACKEND_PORT__
# __TLS_TERM_PORT__ __CERT_DIR__
# ---------------------------------------------------------------------------
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /var/log/nginx/access.log;
    sendfile      on;
    keepalive_timeout 65;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    client_max_body_size 512m;   # STEP / 大 STL 上传
    proxy_read_timeout   900s;   # 晶格生成是长任务，别掐断
    proxy_send_timeout   900s;

    server {
        listen 127.0.0.1:__TLS_TERM_PORT__ ssl;
        server_name _;

        ssl_certificate     __CERT_DIR__/fullchain.pem;
        ssl_certificate_key __CERT_DIR__/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_session_cache   shared:CADTLS:4m;
        ssl_session_timeout 10m;

        location / {
            proxy_pass http://127.0.0.1:__BACKEND_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
        }
    }
}

stream {
    map $ssl_preread_protocol $cad_upstream {
        ""      127.0.0.1:__BACKEND_PORT__;      # 明文 HTTP
        default 127.0.0.1:__TLS_TERM_PORT__;     # TLS
    }

    server {
        listen __TLS_PORT__;
        ssl_preread on;
        proxy_pass $cad_upstream;
        proxy_connect_timeout 10s;
        proxy_timeout 900s;
    }
}
